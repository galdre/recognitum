{:paths ["src" "resources"]

 :deps {org.clojure/clojure {:mvn/version "1.12.5"}}

 :aliases
 {;; The demos and the walkthroughs.
  ;;   clojure -M:dev -m demo.heist-run
  ;;   clojure -M:dev -m demo.potion-run
  ;;   clojure -M:dev -m demo.authz
  ;;   clojure -M:dev -m demo.orders
  :dev {:extra-paths ["dev"]}

  ;; Prints a table: each row times an operation on a recognitum type and on a hand-written
  ;; defrecord that checks the same things, in nanoseconds per call, and their ratio.
  ;;   clojure -M:bench -e "(require 'recognitum.bench)(recognitum.bench/run)"
  :bench {:extra-paths ["bench"]}

  ;;   clojure -X:test
  ;; test/corpus holds one file per form the macros accept or refuse; recognitum.corpus-test
  ;; loads each one.
  :test {:extra-paths ["dev" "test" "test/corpus" "test/corpus/usage"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      org.clojure/test.check {:mvn/version "1.1.1"}}
         :exec-fn cognitect.test-runner.api/test}

  ;; Checks the formatting of the paths .cljfmt.edn names; fix rewrites what check reports.
  ;;   clojure -M:fmt check
  ;;   clojure -M:fmt fix
  :fmt {:extra-deps {dev.weavejester/cljfmt {:mvn/version "0.16.4"}}
        :main-opts ["-m" "cljfmt.main" "--file-pattern" "\\.(?:clj[csx]?|bb|edn)$"]}}}

